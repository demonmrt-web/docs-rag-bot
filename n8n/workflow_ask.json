{
  "name": "Вопрос по документам (RAG)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ask",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "docs-rag-ask"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/ask",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ question: $json.body.question }) }}",
        "options": { "timeout": 300000 }
      },
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "RAG API /ask",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "text",
              "type": "string",
              "value": "={{ $json.answer + ($json.sources.length ? '\\n\\nИсточники: ' + $json.sources.map(s => '[' + s.n + '] ' + s.source).join(', ') : '') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "Собрать ответ",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [720, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { answer: $json.text } }}",
        "options": {}
      },
      "id": "44444444-4444-4444-8444-444444444444",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "RAG API /ask", "type": "main", "index": 0 }]] },
    "RAG API /ask": { "main": [[{ "node": "Собрать ответ", "type": "main", "index": 0 }]] },
    "Собрать ответ": { "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
